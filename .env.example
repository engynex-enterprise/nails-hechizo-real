# ============================================================
#  Integración con Google Calendar (opcional pero recomendado)
# ------------------------------------------------------------
#  Cuando estas 3 variables están configuradas, cada cita que
#  se agende en la web se crea AUTOMÁTICAMENTE en el Google
#  Calendar del negocio. Si no las configuras, el sitio sigue
#  funcionando y el cliente puede agregar la cita con el botón
#  "Agregar a Google Calendar".
#
#  Cómo obtenerlas (una sola vez):
#  1. Entra a https://console.cloud.google.com/ y crea un proyecto.
#  2. Habilita la "Google Calendar API".
#  3. Crea una "Cuenta de servicio" y genera una clave JSON.
#  4. Copia el "client_email" y la "private_key" del JSON aquí abajo.
#  5. En Google Calendar del negocio → Configuración del calendario →
#     "Compartir con determinadas personas" → agrega ese client_email
#     con permiso "Hacer cambios en los eventos".
#  6. Copia el "ID del calendario" (Configuración → Integrar calendario).
#
#  Para producción (Vercel u otro), agrega estas mismas variables
#  en el panel de variables de entorno del hosting.
# ============================================================

GOOGLE_CLIENT_EMAIL="cuenta-servicio@tu-proyecto.iam.gserviceaccount.com"

# Pega la private_key completa entre comillas. Deja los \n tal cual
# (el código los convierte a saltos de línea automáticamente).
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"

# El correo del calendario, ej: nailshechizoreal@gmail.com
GOOGLE_CALENDAR_ID="tucalendario@gmail.com"
